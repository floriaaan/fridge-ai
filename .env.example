# Read by `docker compose` (compose.yml). The backend's local dev server
# reads backend/.env instead.

#--------------------------------------------------------------------
# Secrets — required, the backend refuses to boot without them. Fill all
# three at once:
#   for k in APP_KEY BETTER_AUTH_SECRET ENCRYPTION_KEY; do sed -i.bak "s|^$k=.*|$k=$(openssl rand -base64 32)|" .env; done; rm .env.bak
#--------------------------------------------------------------------
APP_KEY=
BETTER_AUTH_SECRET=
# Encrypts stored secrets (Home Assistant token): 32 bytes, base64.
ENCRYPTION_KEY=

#--------------------------------------------------------------------
# Addresses. NETWORK_URL is how the phone reaches the API: use the
# machine's LAN IP (or a public domain), not localhost.
#--------------------------------------------------------------------
BACKEND_PORT=3333
APP_URL=http://localhost:3333
NETWORK_URL=http://192.168.1.10:3333
LOG_LEVEL=info

# Database (container-internal; POSTGRES_PORT is only the host-side port).
POSTGRES_USER=garde_manger
POSTGRES_PASSWORD=garde_manger
POSTGRES_DB=garde_manger
POSTGRES_PORT=5432

#--------------------------------------------------------------------
# CORS / better-auth trustedOrigins — comma-separated. `exp://` = Expo Go,
# `gardemanger://` = the installed app; add a web origin if you have one.
#--------------------------------------------------------------------
CORS_ORIGIN=exp://,gardemanger://

#--------------------------------------------------------------------
# PocketID (OIDC) — optional. Leave unset to disable the "pocketid" auth
# method (cf. docs/adr/0005) — password login still works on its own.
#--------------------------------------------------------------------
# POCKETID_ISSUER_URL=https://auth.example.com
# POCKETID_CLIENT_ID=
# POCKETID_CLIENT_SECRET=

# Set to true to disable email/password sign-in entirely (PocketID-only instance).
DISABLE_PASSWORD_LOGIN=false

#--------------------------------------------------------------------
# AI provider (settings, cf. docs/adr/0007) — receipt scan needs at least
# one of these configured. Leave a provider's key unset to exclude it from
# `availableProviders`.
#--------------------------------------------------------------------
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434   # Ollama on the Docker host
# OLLAMA_VISION_MODEL=llava   # must be a vision-capable model (cf. docs/adr/0006)
# OLLAMA_TEXT_MODEL=llama3.1

#--------------------------------------------------------------------
# Observability — part of the default stack (cf. docs/adr/0011).
# `task up` starts the collector and OpenObserve alongside the app.
# `task up:app-only` starts db + backend without them.
#--------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
APP_VERSION=0.0.0
DEPLOY_ENV=homelab
TELEMETRY_INGEST_ENABLED=true
TELEMETRY_OTLP_ENDPOINT=http://otel-collector:4318
TELEMETRY_RATE_LIMIT_PER_MINUTE=60

# OpenObserve (UI + store). CHANGE THESE. The collector authenticates with the
# same credentials, base64-encoded:
#   echo -n "you@example.com:your-password" | base64
OPENOBSERVE_ROOT_EMAIL=admin@garde-manger.local
OPENOBSERVE_ROOT_PASSWORD=Complexpass#123
OTLP_STORE_AUTH=YWRtaW5AZnJpZGdlLmxvY2FsOkNvbXBsZXhwYXNzIzEyMw==
OTLP_STORE_ENDPOINT=http://openobserve:5080/api/default
OBSERVABILITY_RETENTION_DAYS=30

# Bind address for the collector + UI ports. Keep 127.0.0.1 and put the UI
# behind the homelab's reverse proxy; 0.0.0.0 exposes an unauthenticated
# OTLP listener to the LAN.
OBSERVABILITY_BIND=127.0.0.1

# Optional: fan out traces/logs to a self-hosted rootprint instance too (cf.
# compose.override.yml.example). Ingest key from rootprint's Settings > API
# keys, scoped to a dedicated index for this app.
# ROOTPRINT_INGEST_TOKEN=

# Public instance stats (GET /api/public/stats) for the landing page — off by
# default: on a one-household instance even aggregate counts describe that
# household. Add the landing's origin to CORS_ORIGIN when enabling it.
# PUBLIC_STATS_ENABLED=false

# GET /api/public/instance — lets the mobile app tell a self-hosted backend
# apart from the (not yet open) hosted offering. Always answers, unlike
# public stats: mode/name/version carry nothing household-specific.
# INSTANCE_MODE=self-hosted
# INSTANCE_NAME=

#--------------------------------------------------------------------
# Landing site (landing/) — build args, inlined at build time because the
# visitor's browser does the fetching: use public URLs.
#--------------------------------------------------------------------
# LANDING_PORT=3000
# LANDING_CONNECTOR=http
# LANDING_API_URL=https://api.example.com
# LANDING_GITHUB_REPO=floriaaan/fridge-ai
