# Node
TZ=UTC
PORT=3333
HOST=localhost
NETWORK_IP=192.168.1.82
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
# Secrets-at-rest key (Home Assistant token) — cf. docs/adr/0012. 32 random
# bytes, base64: `openssl rand -base64 32`.
ENCRYPTION_KEY=
NETWORK_URL=http://${NETWORK_IP}:${PORT}
APP_URL=http://${HOST}:${PORT}

# better-auth session/cookie signing key (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=fridge_ai
DB_PASSWORD=fridge_ai
DB_DATABASE=fridge_ai

#--------------------------------------------------------------------
# CORS / better-auth trustedOrigins — the browser/app-facing origin(s).
# Comma-separated. Mobile dev: add "exp://" ; mobile prod: "fridgeai://" (included below).
#--------------------------------------------------------------------
CORS_ORIGIN=http://localhost:8081,http://${NETWORK_IP}:8081,fridgeai://

#--------------------------------------------------------------------
# PocketID (OIDC) — optional. Leave unset to disable the "pocketid" auth
# method (cf. docs/adr/0005) — password login still works on its own.
#--------------------------------------------------------------------
# POCKETID_ISSUER_URL=https://auth.example.com
# POCKETID_CLIENT_ID=
# POCKETID_CLIENT_SECRET=

# Set to true to disable email/password sign-in entirely (PocketID-only instance).
DISABLE_PASSWORD_LOGIN=false

#--------------------------------------------------------------------
# AI provider (settings, cf. docs/adr/0007) — receipt scan needs at least
# one of these configured. Leave a provider's key unset to exclude it from
# `availableProviders`.
#--------------------------------------------------------------------
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_VISION_MODEL=llava   # must be a vision-capable model (cf. docs/adr/0006)
# OLLAMA_TEXT_MODEL=llama3.1

#--------------------------------------------------------------------
# Local image storage (receipts, products) — cf. docs/adr/0009.
#--------------------------------------------------------------------
STORAGE_ROOT=./data/storage

#--------------------------------------------------------------------
# Observability — cf. docs/adr/0011 and docs/observabilite.md.
# On by default. The app runs identically if the collector is unreachable:
# exports are batched, retried and eventually dropped, never awaited.
#--------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=fridge-ai-backend
# Head sampling. `parentbased_traceidratio` keeps the app's decision when the
# mobile client sent a traceparent, and applies the ratio to its own roots.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
APP_VERSION=0.0.0
DEPLOY_ENV=development

# Mobile telemetry relay (POST /api/telemetry/v1/*). The phone never reaches
# the collector directly — cf. docs/adr/0011.
TELEMETRY_INGEST_ENABLED=true
TELEMETRY_OTLP_ENDPOINT=http://localhost:4318
TELEMETRY_MAX_BODY_BYTES=262144
TELEMETRY_RATE_LIMIT_PER_MINUTE=60
