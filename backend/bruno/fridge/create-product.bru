meta {
  name: Create product
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/products
  body: json
  auth: none
}

headers {
  Cookie: {{cookie}}
}

body:json {
  {
    "name": "Lait",
    "quantity": { "amount": 1, "unit": "L" },
    "location": "fridge",
    "category": "Produits laitiers"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.product && body.product.id) {
    bru.setVar("productId", body.product.id);
  }
}
