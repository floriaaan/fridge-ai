meta {
  name: Create household
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/households
  body: json
  auth: none
}

headers {
  Cookie: {{cookie}}
}

body:json {
  {
    "name": "Chez nous"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.household && body.household.inviteCode) {
    bru.setVar("inviteCode", body.household.inviteCode);
  }
}
