meta {
  name: Sign out
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/sign-out
  body: none
  auth: none
}

headers {
  Cookie: {{cookie}}
  Origin: {{corsOrigin}}
}

docs {
  better-auth requires Origin on cookie-authenticated mutations (CSRF
  protection) and rejects a missing one with 403 MISSING_OR_NULL_ORIGIN.
  {{corsOrigin}} must match backend/.env's CORS_ORIGIN.
}
