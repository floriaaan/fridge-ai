meta {
  name: Create shopping item
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/shopping-items
  body: json
  auth: none
}

headers {
  Cookie: {{cookie}}
}

body:json {
  {
    "name": "Farine",
    "quantity": { "amount": 1, "unit": "kg" },
    "source": "manual"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.item && body.item.id) {
    bru.setVar("itemId", body.item.id);
  }
}
