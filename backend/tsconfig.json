{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./build",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "#domain/*": ["./src/domain/*"],
      "#application/*": ["./src/application/*"],
      "#infrastructure/*": ["./src/infrastructure/*"],
      "#presentation/*": ["./src/presentation/*"]
    }
  }
}
