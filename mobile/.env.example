EXPO_PUBLIC_CONNECTOR=http
# Web build: point at `task dev:proxy` (:8080) instead of the backend's own
# :3333 — same-origin proxy in front of Metro + backend, so the browser
# never sees a cross-site request and the session cookie stays
# SameSite=Lax, no HTTPS/cert dance needed. Native/Expo-client auth works
# fine against either, since it never goes through a browser cookie.
EXPO_PUBLIC_API_URL=http://localhost:3333

# Observability — cf. docs/observabilite.md. Telemetry is posted to the
# backend relay (EXPO_PUBLIC_API_URL), never to a collector. Set to "false"
# to compile the app with no telemetry at all.
EXPO_PUBLIC_TELEMETRY_ENABLED=true
EXPO_PUBLIC_TELEMETRY_SAMPLE_RATIO=1
EXPO_PUBLIC_APP_ENV=development
