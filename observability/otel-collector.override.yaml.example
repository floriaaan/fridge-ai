# Copy to otel-collector.override.yaml (gitignored — infra-specific) and fill
# in your own endpoint, then mount it via compose.override.yml (see
# compose.override.yml.example). otelcol takes one `--config` file, so this
# is a full copy of otel-collector.yaml plus the extra exporter/pipeline
# entries — not a diff.
#
# rootprint accepts logs and traces only (no metrics) over OTLP HTTP+protobuf
# — cf. docs.rootprint.io/send-logs/otlp — so otlphttp/rootprint is added to
# the traces and logs pipelines but deliberately left out of metrics.

receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
        max_recv_msg_size_mib: 8
      http:
        endpoint: 0.0.0.0:4318

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 384
    spike_limit_mib: 96

  attributes/redact:
    actions:
      - action: delete
        pattern: (?i).*(authorization|cookie|set-cookie|password|passwd|token|secret|api[-_]?key|credential|session[-_]?id|x-api-key).*
      - action: delete
        key: db.statement.parameters
      - action: delete
        key: url.query

  filter/noise:
    error_mode: ignore
    traces:
      span:
        - attributes["url.path"] == "/health"
        - attributes["http.route"] == "/health"

  resource/env:
    attributes:
      - key: deployment.environment.name
        value: ${env:DEPLOY_ENV}
        action: upsert

  batch:
    send_batch_size: 512
    send_batch_max_size: 1024
    timeout: 5s

connectors:
  spanmetrics:
    histogram:
      explicit:
        buckets: [10ms, 50ms, 100ms, 250ms, 500ms, 1s, 2s, 5s, 10s]
    dimensions:
      - name: http.route
      - name: http.response.status_code
      - name: service.version
    metrics_flush_interval: 30s

exporters:
  otlphttp/store:
    endpoint: ${env:OTLP_STORE_ENDPOINT}
    headers:
      Authorization: Basic ${env:OTLP_STORE_AUTH}
    sending_queue:
      enabled: true
      num_consumers: 4
      queue_size: 2000
    retry_on_failure:
      enabled: true
      initial_interval: 5s
      max_interval: 60s
      max_elapsed_time: 10m

  # Fan-out to a self-hosted rootprint instance. Auto-suffixes /v1/traces and
  # /v1/logs — do not add a trailing slash or a path here. Use a rootprint
  # ingest key scoped to a dedicated index for this app's logs, separate from
  # any index rootprint uses for its own db/quickwit/rootprint container logs.
  otlphttp/rootprint:
    endpoint: https://<your-rootprint-host>
    headers:
      Authorization: "Bearer ${env:ROOTPRINT_INGEST_TOKEN}"
    sending_queue:
      enabled: true
    retry_on_failure:
      enabled: true

  # One line per received log record on the collector's own stdout — `task
  # obs:logs` is otherwise blind to whether anything is even arriving. Its
  # output goes through the collector's own logger at `info`, so
  # `service.telemetry.logs.level` below has to allow that level through or
  # this prints nothing even while every record is arriving and exporting
  # fine — found the hard way: `level: warn` silently ate every line.
  debug:
    verbosity: normal

extensions:
  health_check:
    endpoint: 0.0.0.0:13133

service:
  extensions: [health_check]
  telemetry:
    logs:
      level: info
  pipelines:
    traces:
      receivers: [otlp]
      processors: [memory_limiter, filter/noise, attributes/redact, resource/env, batch]
      exporters: [otlphttp/store, spanmetrics, otlphttp/rootprint]
    metrics:
      receivers: [otlp, spanmetrics]
      processors: [memory_limiter, attributes/redact, resource/env, batch]
      exporters: [otlphttp/store]
    logs:
      receivers: [otlp]
      processors: [memory_limiter, attributes/redact, resource/env, batch]
      exporters: [otlphttp/store, otlphttp/rootprint, debug]
